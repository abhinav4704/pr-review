# Docker image with Node + npm runtime (Node 20 avoids current Windows Node 22 scip-python issue)
NODE_IMAGE=node:20-bookworm

# Graph repo name tag inside Neo4j
REPO_NAME=sail

# Neo4j connection used by graph_rag indexer
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# SCIP package version installed in container
SCIP_PYTHON_VERSION=latest
