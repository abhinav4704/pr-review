# Host path of the repo to index (bind-mounted to /work/repo in the indexer).
#   macOS/Linux example: REPO_PATH=../sail
#   Windows example:     REPO_PATH=D:/Downloads/sail
REPO_PATH=../sail

# Graph repo name tag inside Neo4j
REPO_NAME=sail

# Neo4j connection used by the indexer
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# --- Phase 2 semantic enrichment (graph_rag.cli semantic) ---
GRAPH_RAG_LLM_PROVIDER=anthropic   # anthropic | bedrock | openai
GRAPH_RAG_LLM_MODEL=               # blank = provider default (e.g. claude-opus-4-8)
GRAPH_RAG_SOURCE_MODE=auto         # auto (code only when no docstring) | never | always
# Provider credentials — set the one matching GRAPH_RAG_LLM_PROVIDER:
ANTHROPIC_API_KEY=                 # provider=anthropic
# OPENAI_API_KEY=                  # provider=openai
# AWS_REGION=                      # provider=bedrock (uses your AWS creds)

# scip-python is pinned to the validated 0.6.6 in the Dockerfile (not @latest).
# Override only if you know what you're doing.
