# Copy to .env and fill in. The app auto-loads .env on startup; the sidebar
# pre-fills from these values and you can still override per session.

# ── GitHub ───────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_your_personal_access_token

# ── Neo4j ────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ── AWS Bedrock (Nova) — primary LLM ─────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
# Optional, for temporary STS credentials:
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
NOVA_MODEL_ID=us.amazon.nova-pro-v1:0

# ── OpenAI — optional alternative LLM ────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
